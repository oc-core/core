{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:occ:spec:community-archive:0.1:log-entry",
  "title": "OCC community archive: one line of governance-log.jsonl",
  "description": "Defined by docs/specs/community-archive.md, version 0.1.",
  "type": "object",
  "required": [
    "seq",
    "at",
    "type",
    "policy",
    "data",
    "prev"
  ],
  "additionalProperties": false,
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "actor": {
      "type": "object",
      "required": [
        "member"
      ],
      "additionalProperties": false,
      "properties": {
        "member": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "acting": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      }
    },
    "policy": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data": {
      "type": "object"
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
