{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:occ:spec:community-archive:0.1:content-item",
  "title": "OCC community archive: content/items/<id>.json",
  "description": "Defined by docs/specs/community-archive.md, version 0.1.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "author",
    "created_at",
    "log_seq",
    "audience",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "log_seq": {
      "type": "integer",
      "minimum": 1
    },
    "audience": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "scope"
          ],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "members"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "scope",
            "roles"
          ],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "roles"
            },
            "roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "scope",
            "members"
          ],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "listed"
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              }
            }
          }
        }
      ]
    },
    "body": {
      "type": "object"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
