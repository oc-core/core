{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:occ:spec:community-archive:0.1:community",
  "title": "OCC community archive: community.json",
  "description": "Defined by docs/specs/community-archive.md, version 0.1.",
  "type": "object",
  "required": [
    "id",
    "name",
    "created_at",
    "privacy_mode",
    "data_controller"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "privacy_mode": {
      "enum": [
        "private",
        "discoverable",
        "federated"
      ]
    },
    "data_controller": {
      "type": "object",
      "required": [
        "kind",
        "member"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "person",
            "organisation"
          ]
        },
        "member": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      }
    },
    "settings": {
      "type": "object"
    },
    "member_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
