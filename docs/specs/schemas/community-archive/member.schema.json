{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:occ:spec:community-archive:0.1:member",
  "title": "OCC community archive: member.json",
  "description": "Defined by docs/specs/community-archive.md, version 0.1.",
  "type": "object",
  "required": [
    "ref",
    "display_name"
  ],
  "additionalProperties": false,
  "properties": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string"
    },
    "profile": {
      "type": "object"
    }
  }
}
